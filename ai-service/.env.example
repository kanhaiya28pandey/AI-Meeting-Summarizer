APP_NAME=AI Meeting Summarizer AI Service
APP_VERSION=1.0.0
HOST=0.0.0.0
PORT=8000
SPRING_BOOT_URL=http://localhost:8080
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-transcribe
MAX_AUDIO_FILE_SIZE_MB=100
TEMP_AUDIO_DIR=./temp/audio
TRANSCRIPTION_ENABLE_DIARIZATION=true
TRANSCRIPTION_ENABLE_TIMESTAMPS=true
MAX_TRANSCRIPT_LENGTH=100000
